app:
  name: "gocms_v2"
  env: "development"  # development, staging, production
  version: "1.0.0-dev"
  timezone: "Asia/Shanghai"

server:
  grpc:
    host: "0.0.0.0"
    port: 9000
    # gRPC 服务器选项
    max_recv_msg_size: 104857600  # 100MB (增大限制)
    max_send_msg_size: 104857600 # 100MB (增大限制)
    keepalive:
      enforcement_policy:
        min_time: "10s"
        permit_without_stream: true
      server_params:
        time: "30s"
        timeout: "5s"
  http:
    host: "0.0.0.0"
    port: 8080
    # HTTP Gateway (grpc-gateway) 选项
    GRPC:
      host: 127.0.0.1
      port: 9000
    read_timeout: "10s"
    write_timeout: "10s"
    idle_timeout: "60s"
    cors:
      allow_origins:
        - "http://localhost:3000"
        - "http://localhost:5173"
      allow_methods:
        - "GET"
        - "POST"
        - "PUT"
        - "PATCH"
        - "DELETE"
        - "OPTIONS"
      allow_headers:
        - "Origin"
        - "Content-Type"
        - "Accept"
        - "Authorization"
        - "X-Request-ID"
      expose_headers:
        - "X-Request-ID"
      allow_credentials: true
      max_age: "12h"

database:
  mysql:
    host: "127.0.0.1"
    port: 3306
    username: "root"
    password: "xxxxxxx."
    database: "gocms_v2"
    charset: "utf8mb4"
    parse_time: true
    loc: "Local"
    # 连接池配置
    max_idle_conns: 10
    max_open_conns: 100
    conn_max_lifetime: "1h"
    conn_max_idle_time: "10m"
    # GORM 选项
    log_level: "info"  # silent, error, warn, info
    slow_threshold: "200ms"
  redis:
    host: "127.0.0.1"
    port: 6379
    password: ""  # 空密码
    db: 0
    # 连接池
    pool_size: 50
    min_idle_conns: 10
    dial_timeout: "5s"
    read_timeout: "3s"
    write_timeout: "3s"
    pool_timeout: "4s"

elasticsearch:
  addresses:
    - "http://127.0.0.1:9200"
  username: "elastic"
  password: ""  # 空密码
  index_prefix: "gocms_"
  # 连接选项
  max_retries: 3
  retry_timeout: "100ms"
  sniff: false
  health_check: true

jwt:
  secret: "g3GwR2AR7RZN9UinJclX3U0Vz5i2ShQb"
  issuer: "gocms_v2"
  access_token_ttl: "2h"      # 访问令牌有效期
  refresh_token_ttl: "720h"   # 刷新令牌有效期 (30天)
  algorithm: "HS256"

upload:
  driver: "local"  # local, s3, oss, cos
  local:
    root_path: "./storage/uploads"
    base_url: "http://localhost:8080/uploads"
  max_file_size: 52428800  # 50MB
  allowed_mimes:
    - "image/jpeg"
    - "image/png"
    - "image/gif"
    - "image/webp"
    - "video/mp4"
    - "application/pdf"
    - "application/msword"
    - "application/vnd.openxmlformats-officedocument.wordprocessingml.document"

log:
  level: "debug"  # debug, info, warn, error
  format: "console"  # console, json
  output: "stdout"   # stdout, file
  file:
    path: "./logs/app.log"
    max_size: 100   # MB
    max_age: 30     # days
    max_backups: 10
    compress: true
  sampling:
    initial: 100
    thereafter: 100

trace:
  enabled: true
  sampler: "always_on"  # always_on, always_off, traceid_ratio, parentbased_traceid_ratio
  ratio: 1.0
  exporter: "stdout"  # stdout, otlp, prometheus

metrics:
  enabled: true
  path: "/metrics"
  port: 9090
